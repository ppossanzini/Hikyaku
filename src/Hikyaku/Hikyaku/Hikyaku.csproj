<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Authors>Paolo Possanzini</Authors>
    <TargetFrameworks>net6.0;netstandard2.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <Features>strict</Features>
    <Description>Hykyaku is an open-source mediator service forked from MediatR v. 12.5.0</Description>
    <PackageTags>mediator;request;response;queries;commands;notifications</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <LangVersion>10</LangVersion>
    <PackageId>Hikyaku</PackageId>
    <PackageIcon>Logo-128.png</PackageIcon>
    <RepositoryUrl>https://github.com/ppossanzini/Hikyaku</RepositoryUrl>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\Hikyaku.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IsExternalInit" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0"/>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
    <PackageReference Include="Hikyaku.Contracts" Version="[9.1.2,]" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.9" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\assets\Logo-128.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
      <Link>Logo-128.png</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="MediatorIntegrations\IMediator.cs" />
    <Compile Remove="MediatorIntegrations\INotificationHandler.cs" />
    <Compile Remove="MediatorIntegrations\INotificationPublisher.cs" />
    <Compile Remove="MediatorIntegrations\IPipelineBehavior.cs" />
    <Compile Remove="MediatorIntegrations\IPublisher.cs" />
    <Compile Remove="MediatorIntegrations\IRequestHandler.cs" />
    <Compile Remove="MediatorIntegrations\ISender.cs" />
    <Compile Remove="MediatorIntegrations\IStreamPipelineBehavior.cs" />
    <Compile Remove="MediatorIntegrations\IStreamRequestHandler.cs" />
    <Compile Remove="MediatorIntegrations\NotificationHandlerExecutor.cs" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="MediatorIntegrations\" />
  </ItemGroup>

  
</Project>
